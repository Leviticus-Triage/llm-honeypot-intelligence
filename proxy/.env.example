# Elasticsearch connection (T-Pot VM)
ES_URL=https://your-tpot-vm:64297/es
ES_USER=your_web_user
ES_PASS=your_web_password
# TLS: path to T-Pot/nginx CA PEM (recommended). Use ES_INSECURE=1 only for local dev.
# ES_CA_BUNDLE=/path/to/nginx.crt
# ES_INSECURE=0

# T-Pot VM IP (used by RL scorer for IP correlation)
TPOT_VM_IP=127.0.0.1
