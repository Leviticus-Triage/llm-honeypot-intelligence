# tpot-cloud-deploy — copy to cloud.env before install/deploy.
#
#   cp cloud.env.example cloud.env
#   sudo ./install.sh
#   # then official tpotce install (see README)
#   sudo ./deploy-custom.sh
#   sudo ./wire-llm.sh

# --- Identity ---
DEPLOY_USER=ubuntu
TZ=Europe/Berlin

# --- This server (T-Pot ECS) — fill after OTC provisioning ---
# Public IP (honeypot ingress, Kibana https://IP:64297)
TPOT_PUBLIC_IP=YOUR_T-POT-ECS-PUBLIC-IP
# Private VPC IP (optional, for OTC internal routing)
TPOT_PRIVATE_IP=

# --- AI stack (existing ai-cloud ECS) ---
AI_STACK_SSH=ai-cloud
AI_STACK_PUBLIC_IP=80.158.17.220
# Use private VPC IP for LLM traffic (recommended when both ECS in same VPC)
AI_STACK_PRIVATE_IP=10.164.18.68
AI_STACK_PROXY_PORT=11435
# URL written into ~/tpotce/.env for Beelzebub/Galah
AI_PROXY_URL=http://10.164.18.68:11435

# --- LLM models (must exist on ai-cloud Ollama) ---
BEELZEBUB_OLLAMA_MODEL=dolphin-llama3:8b
GALAH_LLM_MODEL=dolphin-llama3:8b

# --- Elasticsearch (generated by tpotce install — fill after install) ---
ES_URL=https://YOUR_T-POT-ECS-PUBLIC-IP:64297/es
ES_USER=REPLACE_AFTER_T-POT_INSTALL
ES_PASS=REPLACE_AFTER_T-POT_INSTALL
ES_INSECURE=1

# --- tpotce source ---
TPOTCE_REPO=https://github.com/telekom-security/tpotce.git
TPOTCE_BRANCH=master
TPOTCE_DIR=/home/ubuntu/tpotce
# Set true on prepare-host only; official install.sh is still manual/interactive
CLONE_TPOTCE=true

# --- Custom stack paths (on this host) ---
CUSTOM_DIR=/home/ubuntu/tpotce/custom
DEPLOY_BUNDLE_DIR=/home/ubuntu/tpot-cloud-deploy

# --- Sync from ai-cloud (noise/blocklist) — configured on ai-cloud later ---
# TPOT_SSH for sync scripts on ai-cloud: admin@<TPOT_PUBLIC_IP>
